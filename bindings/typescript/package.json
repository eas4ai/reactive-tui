{
  "name": "@reactive-tui/core",
  "version": "0.1.0",
  "description": "TypeScript bindings for reactive-tui - A modern terminal UI framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:rust": "cd ../.. && cargo build --release --features ffi",
    "prebuild": "npm run build:rust",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "npm run build",
    "example:hello": "ts-node examples/hello-world.ts",
    "example:animation": "ts-node examples/animation-demo.ts",
    "example:component": "ts-node examples/component-demo.ts",
    "example:widgets": "ts-node examples/widgets-demo.ts"
  },
  "keywords": [
    "terminal",
    "tui",
    "ui",
    "react",
    "component",
    "ffi",
    "rust"
  ],
  "author": "Reactive TUI Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/ffi-napi": "^4.0.10",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/ref-napi": "^3.0.12",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ffi-napi": "^4.0.3",
    "ref-napi": "^3.0.3",
    "ref-struct-napi": "^1.1.1"
  },
  "files": [
    "dist",
    "native"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reactive-tui/reactive-tui.git",
    "directory": "bindings/typescript"
  }
}